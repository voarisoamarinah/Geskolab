{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": false,
    "target": "esnext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    
    // CHANGE CES LIGNES :
    "verbatimModuleSyntax": false, 
    "isolatedModules": false,
    "moduleDetection": "auto"
  }
}